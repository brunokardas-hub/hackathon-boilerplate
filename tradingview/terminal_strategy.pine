// This Pine Script® code is subject to the terms of the MIT License (see LICENSE).
// Backtester for the terminal's setups. Same rules as the website's BACKTEST
// screen: enter on the bar after a signal, ATR stop, target in R, optional
// trailing stop or half-off at 1R, commission and slippage on every fill.
// Results are split into in-sample (tune here) and out-of-sample (the real test).
//@version=6
strategy("Terminal Strategy — Backtester", shorttitle = "TERMINAL BT", overlay = true,
     initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1,
     slippage = 2, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_S = "Setup"
setup    = input.string("Breakout", "Setup", options = ["Breakout", "Pullback to EMA20", "Volume spike", "Score 70/30"], group = G_S)
dirOpt   = input.string("Long only", "Direction", options = ["Long only", "Short only", "Both"], group = G_S)

const string G_R = "Risk & exits"
riskPct  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, step = 0.1, group = G_R)
atrLen   = input.int(14, "ATR length", minval = 1, group = G_R)
stopMult = input.float(1.5, "Stop (× ATR)", minval = 0.3, step = 0.1, group = G_R)
targetR  = input.float(2.0, "Target (R)", minval = 0.5, step = 0.5, group = G_R)
exitMode = input.string("Fixed target", "Exit", options = ["Fixed target", "Trailing stop", "Half at 1R, rest at target"], group = G_R)
maxBars  = input.int(40, "Max bars held", minval = 1, group = G_R)

const string G_T = "Test period"
fromT    = input.time(timestamp("2018-01-01T00:00:00"), "Test from", group = G_T)
oosT     = input.time(timestamp("2024-01-01T00:00:00"), "Out-of-sample starts", group = G_T, tooltip = "Tune settings while looking only at results before this date. Trust the setup only if results after it hold up too.")

// ───────────────────────────── Indicators ─────────────────────────────
e20    = ta.ema(close, 20)
e50    = ta.ema(close, 50)
e200   = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)
atr    = ta.atr(atrLen)
volAvg = ta.sma(volume, 20)
hh20   = ta.highest(high, 20)[1]
ll20   = ta.lowest(low, 20)[1]
[macd, macdSig, macdHist] = ta.macd(close, 12, 26, 9)
hi252  = ta.highest(high, 252)
lo252  = ta.lowest(low, 252)
pos252 = hi252 > lo252 ? (close - lo252) / (hi252 - lo252) : 0.5
score  = (close > e200 ? 20 : 0) + (e20 > e50 ? 15 : 0) + (close > e50 ? 10 : 0)
     + (rsi >= 50 and rsi <= 70 ? 15 : rsi > 70 ? 8 : rsi >= 40 ? 5 : 0)
     + (macdHist > 0 ? 10 : 0) + (close > close[21] ? 15 : 0) + pos252 * 15
upTrend = close > e50 and e20 > e50
dnTrend = close < e50 and e20 < e50
volX    = volAvg > 0 ? volume / volAvg : 0
scUp    = ta.crossover(score, 70)
scDn    = ta.crossunder(score, 30)

longSig = switch setup
    "Breakout"          => close > hh20 and volX >= 1.5
    "Pullback to EMA20" => upTrend and low <= e20 and close > e20 and close > open
    "Volume spike"      => volX >= 2 and close > open and close > e50
    => scUp
shortSig = switch setup
    "Breakout"          => close < ll20 and volX >= 1.5
    "Pullback to EMA20" => dnTrend and high >= e20 and close < e20 and close < open
    "Volume spike"      => volX >= 2 and close < open and close < e50
    => scDn
allowLong  = dirOpt != "Short only"
allowShort = dirOpt != "Long only"
inTest     = time >= fromT

// ───────────────────────────── Orders ─────────────────────────────
var float stopPx  = na
var float tgtPx   = na
var float oneRPx  = na
var int   entryBar = na
var bool  halfDone = false

flat = strategy.position_size == 0
if flat and inTest and not na(atr)
    dist = stopMult * atr
    if longSig and allowLong
        qty = strategy.equity * riskPct / 100 / dist
        qty := math.min(qty, strategy.equity / close)
        stopPx := close - dist
        tgtPx := close + targetR * dist
        oneRPx := close + dist
        entryBar := bar_index + 1
        halfDone := false
        strategy.entry("L", strategy.long, qty = qty)
    else if shortSig and allowShort
        qty = strategy.equity * riskPct / 100 / dist
        qty := math.min(qty, strategy.equity / close)
        stopPx := close + dist
        tgtPx := close - targetR * dist
        oneRPx := close - dist
        entryBar := bar_index + 1
        halfDone := false
        strategy.entry("S", strategy.short, qty = qty)

isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0

// Trailing stop follows the close by the same ATR distance; never loosens.
if exitMode == "Trailing stop" and isLong
    stopPx := math.max(stopPx, close - stopMult * atr)
if exitMode == "Trailing stop" and isShort
    stopPx := math.min(stopPx, close + stopMult * atr)
// After half comes off at 1R, the rest moves its stop to breakeven.
if exitMode == "Half at 1R, rest at target" and not halfDone and strategy.position_size != 0
    if (isLong and high >= oneRPx) or (isShort and low <= oneRPx)
        halfDone := true
        stopPx := strategy.position_avg_price

if isLong
    if exitMode == "Trailing stop"
        strategy.exit("XL", "L", stop = stopPx)
    else if exitMode == "Half at 1R, rest at target"
        strategy.exit("XL1", "L", qty_percent = 50, stop = stopPx, limit = oneRPx)
        strategy.exit("XL2", "L", stop = stopPx, limit = tgtPx)
    else
        strategy.exit("XL", "L", stop = stopPx, limit = tgtPx)
if isShort
    if exitMode == "Trailing stop"
        strategy.exit("XS", "S", stop = stopPx)
    else if exitMode == "Half at 1R, rest at target"
        strategy.exit("XS1", "S", qty_percent = 50, stop = stopPx, limit = oneRPx)
        strategy.exit("XS2", "S", stop = stopPx, limit = tgtPx)
    else
        strategy.exit("XS", "S", stop = stopPx, limit = tgtPx)
if strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar + 1 >= maxBars
    strategy.close_all(comment = "time")

plot(strategy.position_size != 0 ? stopPx : na, "Stop", color = color.new(#FF433D, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 and exitMode != "Trailing stop" ? tgtPx : na, "Target", color = color.new(#4AF626, 0), style = plot.style_linebr)
bgcolor(time >= oosT ? color.new(#FB8B1E, 92) : na, title = "Out-of-sample period")

// ───────────────────────────── In-sample vs out-of-sample ─────────────────────────────
f_row(table t, int r, string label, int n, int w, float gp, float gl, float net) =>
    pf = gl > 0 ? gp / gl : na
    table.cell(t, 0, r, label, text_color = #FB8B1E, text_font_family = font.family_monospace, text_size = size.small)
    table.cell(t, 1, r, str.tostring(n), text_color = #E6E6E6, text_font_family = font.family_monospace, text_size = size.small)
    table.cell(t, 2, r, n > 0 ? str.tostring(100.0 * w / n, "0") + "%" : "—", text_color = #E6E6E6, text_font_family = font.family_monospace, text_size = size.small)
    table.cell(t, 3, r, na(pf) ? "—" : str.tostring(pf, "0.00"), text_color = na(pf) ? #8C8C8C : pf >= 1 ? #4AF626 : #FF433D, text_font_family = font.family_monospace, text_size = size.small)
    table.cell(t, 4, r, str.tostring(net, "#,##0"), text_color = net >= 0 ? #4AF626 : #FF433D, text_font_family = font.family_monospace, text_size = size.small)
    table.cell(t, 5, r, n > 0 ? str.tostring(net / n, "#,##0.00") : "—", text_color = net >= 0 ? #4AF626 : #FF433D, text_font_family = font.family_monospace, text_size = size.small)

var table T = table.new(position.top_right, 6, 4, bgcolor = #000000, frame_color = #FB8B1E, frame_width = 1, border_color = #262626, border_width = 1)
if barstate.islastconfirmedhistory or barstate.islast
    int nI = 0
    int wI = 0
    float gpI = 0.0
    float glI = 0.0
    int nO = 0
    int wO = 0
    float gpO = 0.0
    float glO = 0.0
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            p = strategy.closedtrades.profit(i)
            if strategy.closedtrades.entry_time(i) < oosT
                nI += 1
                wI += p > 0 ? 1 : 0
                gpI += math.max(p, 0)
                glI += math.max(-p, 0)
            else
                nO += 1
                wO += p > 0 ? 1 : 0
                gpO += math.max(p, 0)
                glO += math.max(-p, 0)
    for c = 0 to 5
        table.cell(T, c, 0, array.get(array.from("", "TRADES", "WIN", "PF", "NET", "AVG TRADE"), c), text_color = #8C8C8C, text_font_family = font.family_monospace, text_size = size.small)
    f_row(T, 1, "IN-SAMPLE", nI, wI, gpI, glI, gpI - glI)
    f_row(T, 2, "OUT-OF-SAMPLE", nO, wO, gpO, glO, gpO - glO)
    pfO = glO > 0 ? gpO / glO : na
    verdictTxt = nO < 15 ? "NOT ENOUGH OUT-OF-SAMPLE TRADES" : not na(pfO) and pfO >= 1.2 ? "EDGE HOLDS OUT-OF-SAMPLE: paper trade it next" : not na(pfO) and pfO >= 1 ? "WEAK: barely breaks even" : "NO EDGE: don't trade this"
    table.cell(T, 0, 3, verdictTxt, text_color = nO < 15 ? #FB8B1E : not na(pfO) and pfO >= 1.2 ? #4AF626 : #FF433D, text_font_family = font.family_monospace, text_size = size.small)
    table.merge_cells(T, 0, 3, 5, 3)
