// This Pine Script® code is subject to the terms of the MIT License (see LICENSE).
// Bloomberg-style market terminal for TradingView: quote, analyst note and score,
// performance, technicals, fundamentals, macro and a monitor in one amber-on-black
// panel, plus a second MARKET panel with a heatmap and a screener.
//@version=6
indicator("Terminal — Bloomberg-Style Dashboard", shorttitle = "TERMINAL", overlay = true)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_LAY = "Layout"
panelPos  = input.string("Top Right", "Panel position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], group = G_LAY)
textSz    = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_LAY)
showPerf  = input.bool(true, "Show PERFORMANCE", group = G_LAY)
showTech  = input.bool(true, "Show TECHNICALS", group = G_LAY)
showFund  = input.bool(true, "Show FUNDAMENTALS (stocks only)", group = G_LAY)
showMacro = input.bool(true, "Show MACRO", group = G_LAY)
showWatch = input.bool(true, "Show MONITOR", group = G_LAY)
showNote  = input.bool(true, "Show ANALYST NOTE", group = G_LAY)

const string G_MKT = "Market panel (heatmap + screener)"
showMkt   = input.bool(true, "Show MARKET panel", group = G_MKT)
mktPos    = input.string("Bottom Left", "Market panel position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], group = G_MKT)
universe  = input.string("US Sectors", "Universe", options = ["US Sectors", "US Mega Caps", "Crypto", "Global Macro", "Custom"], group = G_MKT)
customLst = input.string("AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,JPM,LLY,V,XOM", "Custom list (up to 12, comma-separated)", group = G_MKT)
heatScale = input.float(3.0, "Heatmap full colour at ±%", minval = 0.1, step = 0.5, group = G_MKT)
showScr   = input.bool(true, "Show SCREENER", group = G_MKT)
scrSort   = input.string("% Change", "Sort by", options = ["% Change", "RSI", "Relative volume"], group = G_MKT)
scrFilter = input.string("All", "Filter", options = ["All", "Gainers", "Losers", "Oversold (RSI < 30)", "Overbought (RSI > 70)", "Unusual volume (RVOL > 1.5)"], group = G_MKT)
scrRows   = input.int(8, "Max screener rows", minval = 1, maxval = 12, group = G_MKT)

const string G_BEN = "Benchmark"
benchSym = input.symbol("AMEX:SPY", "Benchmark (relative strength)", group = G_BEN)

const string G_W = "Monitor (watchlist)"
w1 = input.symbol("AMEX:SPY", "1", group = G_W)
w2 = input.symbol("NASDAQ:QQQ", "2", group = G_W)
w3 = input.symbol("TVC:DXY", "3", group = G_W)
w4 = input.symbol("TVC:US10Y", "4", group = G_W)
w5 = input.symbol("TVC:GOLD", "5", group = G_W)
w6 = input.symbol("BITSTAMP:BTCUSD", "6", group = G_W)

const string G_MAC = "Macro"
macroCC = input.string("US", "Country", options = ["US", "EU", "GB", "JP", "CN", "CA", "AU", "DE", "CH"], group = G_MAC)

const string G_TA = "Technicals"
rsiLen = input.int(14, "RSI length", minval = 2, group = G_TA)
atrLen = input.int(14, "ATR length", minval = 1, group = G_TA)
maLen1 = input.int(20, "EMA fast", minval = 1, group = G_TA)
maLen2 = input.int(50, "EMA mid", minval = 1, group = G_TA)
maLen3 = input.int(200, "EMA slow", minval = 1, group = G_TA)

const string G_OV = "Chart overlays"
showMA   = input.bool(true, "Plot EMAs", group = G_OV)
showVWAP = input.bool(true, "Plot VWAP", group = G_OV)
showPDHL = input.bool(true, "Plot prior-day high/low (intraday)", group = G_OV)

const string G_AL = "Alerts"
lvlAbove = input.float(0.0, "Price crosses above (0 = off)", minval = 0, group = G_AL, tooltip = "Your own level. Re-create the TradingView alert after changing it: alerts keep the settings they were created with.")
lvlBelow = input.float(0.0, "Price crosses below (0 = off)", minval = 0, group = G_AL)
volMult  = input.float(2.0, "Volume spike: at least × the 20-bar average", minval = 1, step = 0.5, group = G_AL)
gapPct   = input.float(2.0, "Gap at the open: at least %", minval = 0.1, step = 0.5, group = G_AL)

// ───────────────────────────── Palette ─────────────────────────────
const color C_BG    = #000000
const color C_ALT   = #0D0D0D
const color C_AMBER = #FB8B1E
const color C_WHITE = #E6E6E6
const color C_GREY  = #8C8C8C
const color C_UP    = #4AF626
const color C_DN    = #FF433D
const color C_BLUE  = #3FA9F5
const color C_GRID  = #262626

// ───────────────────────────── Helpers ─────────────────────────────
f_pos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Middle Right" => position.middle_right
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

f_ret(float a, float b) => na(a) or na(b) or b == 0 ? na : (a / b - 1) * 100

f_pct(float x) => na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + "%"

f_px(float x) => na(x) ? "—" : str.tostring(x, format.mintick)

// Price formatter for other symbols, where the chart's mintick does not apply.
f_num(float x) =>
    na(x) ? "—" : math.abs(x) >= 1000 ? str.tostring(x, "#,##0.00") : math.abs(x) >= 1 ? str.tostring(x, "0.00") : str.tostring(x, "0.0000")

f_vol(float x) => na(x) ? "—" : str.tostring(x, format.volume)

f_col(float x) => na(x) ? C_GREY : x >= 0 ? C_UP : C_DN

f_ticker(string s) =>
    parts = str.split(s, ":")
    array.get(parts, array.size(parts) - 1)

// ───────────────────────────── Data ─────────────────────────────
// Daily context for the chart symbol (quote, ranges, performance).
[dC, dPC, dO, dH, dL, dV, dAvgV, h52, l52, c5, c21, c63, c252] = request.security(syminfo.tickerid, "D",
     [close, close[1], open, high, low, volume, ta.sma(volume, 20), ta.highest(high, 252), ta.lowest(low, 252), close[5], close[21], close[63], close[252]])

// Prior-year close (non-repainting idiom) for YTD, and prior-day levels for overlays.
yC = request.security(syminfo.tickerid, "12M", close[1], lookahead = barmerge.lookahead_on)
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

[bC, b21, b63] = request.security(benchSym, "D", [close, close[21], close[63]], ignore_invalid_symbol = true)

f_quote(string s) => request.security(s, "D", [close, close[1]], ignore_invalid_symbol = true)
[q1, p1] = f_quote(w1)
[q2, p2] = f_quote(w2)
[q3, p3] = f_quote(w3)
[q4, p4] = f_quote(w4)
[q5, p5] = f_quote(w5)
[q6, p6] = f_quote(w6)

// Fundamentals (na for symbols without financial data, e.g. crypto or FX).
isStock = syminfo.type == "stock"
epsTTM  = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "TTM", ignore_invalid_symbol = true)
revTTM  = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "TTM", ignore_invalid_symbol = true)
revFQ   = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", barmerge.gaps_on, ignore_invalid_symbol = true)
shares  = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol = true)
grossM  = request.financial(syminfo.tickerid, "GROSS_MARGIN", "TTM", ignore_invalid_symbol = true)
netM    = request.financial(syminfo.tickerid, "NET_MARGIN", "TTM", ignore_invalid_symbol = true)
roe     = request.financial(syminfo.tickerid, "RETURN_ON_EQUITY", "FQ", ignore_invalid_symbol = true)
debtEq  = request.financial(syminfo.tickerid, "DEBT_TO_EQUITY", "FQ", ignore_invalid_symbol = true)
fcfTTM  = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "TTM", ignore_invalid_symbol = true)
divYld  = request.financial(syminfo.tickerid, "DIVIDENDS_YIELD", "FY", ignore_invalid_symbol = true)
epsAct  = request.earnings(syminfo.tickerid, earnings.actual, ignore_invalid_symbol = true)
epsEst  = request.earnings(syminfo.tickerid, earnings.estimate, ignore_invalid_symbol = true)
// Same quarter last year: the 4th report before the latest one (needs ~1y+ of loaded bars).
revYoY  = f_ret(revFQ, ta.valuewhen(not na(revFQ), revFQ, 4))

// Macro series from TradingView's ECONOMICS feed, with the previous release for the change.
f_eco(string code, string tf) => request.security("ECONOMICS:" + macroCC + code, tf, [close, close[1]], ignore_invalid_symbol = true)
[ecoRate, ecoRateP] = f_eco("INTR", "1M")
[ecoInfl, ecoInflP] = f_eco("IRYY", "1M")
[ecoUnem, ecoUnemP] = f_eco("UR", "1M")
[ecoGdp, ecoGdpP]   = f_eco("GDPQQ", "3M")

// Market universe: 12 symbols for the heatmap and screener, one daily request each
// returning [close, previous close, RSI14, volume ÷ 20-day average volume].
var UNI_SECT = array.from("AMEX:XLK", "AMEX:XLF", "AMEX:XLV", "AMEX:XLY", "AMEX:XLC", "AMEX:XLI", "AMEX:XLP", "AMEX:XLE", "AMEX:XLU", "AMEX:XLB", "AMEX:XLRE", "AMEX:SPY")
var UNI_MEGA = array.from("NASDAQ:AAPL", "NASDAQ:MSFT", "NASDAQ:NVDA", "NASDAQ:AMZN", "NASDAQ:GOOGL", "NASDAQ:META", "NASDAQ:TSLA", "NASDAQ:AVGO", "NYSE:BRK.B", "NYSE:JPM", "NYSE:LLY", "NYSE:V")
var UNI_CRYP = array.from("BINANCE:BTCUSDT", "BINANCE:ETHUSDT", "BINANCE:SOLUSDT", "BINANCE:BNBUSDT", "BINANCE:XRPUSDT", "BINANCE:DOGEUSDT", "BINANCE:ADAUSDT", "BINANCE:AVAXUSDT", "BINANCE:LINKUSDT", "BINANCE:DOTUSDT", "BINANCE:TRXUSDT", "BINANCE:LTCUSDT")
var UNI_MACR = array.from("AMEX:SPY", "NASDAQ:QQQ", "AMEX:IWM", "AMEX:EFA", "AMEX:EEM", "TVC:DXY", "TVC:US10Y", "TVC:GOLD", "TVC:USOIL", "FX:EURUSD", "FX:USDJPY", "BITSTAMP:BTCUSD")
var UNI_CUST = str.split(str.replace_all(str.upper(customLst), " ", ""), ",")

f_uni(int i) =>
    switch universe
        "US Mega Caps" => array.get(UNI_MEGA, i)
        "Crypto"       => array.get(UNI_CRYP, i)
        "Global Macro" => array.get(UNI_MACR, i)
        "Custom"       => i < array.size(UNI_CUST) ? array.get(UNI_CUST, i) : ""
        => array.get(UNI_SECT, i)

// Empty custom slots request the chart symbol and are skipped when drawing.
f_mkt(string s) => request.security(s == "" ? syminfo.tickerid : s, "D", [close, close[1], ta.rsi(close, 14), volume / ta.sma(volume, 20)], ignore_invalid_symbol = true)
string u0 = f_uni(0)
string u1 = f_uni(1)
string u2 = f_uni(2)
string u3 = f_uni(3)
string u4 = f_uni(4)
string u5 = f_uni(5)
string u6 = f_uni(6)
string u7 = f_uni(7)
string u8 = f_uni(8)
string u9 = f_uni(9)
string u10 = f_uni(10)
string u11 = f_uni(11)
[mc0, mp0, mr0, mv0] = f_mkt(u0)
[mc1, mp1, mr1, mv1] = f_mkt(u1)
[mc2, mp2, mr2, mv2] = f_mkt(u2)
[mc3, mp3, mr3, mv3] = f_mkt(u3)
[mc4, mp4, mr4, mv4] = f_mkt(u4)
[mc5, mp5, mr5, mv5] = f_mkt(u5)
[mc6, mp6, mr6, mv6] = f_mkt(u6)
[mc7, mp7, mr7, mv7] = f_mkt(u7)
[mc8, mp8, mr8, mv8] = f_mkt(u8)
[mc9, mp9, mr9, mv9] = f_mkt(u9)
[mc10, mp10, mr10, mv10] = f_mkt(u10)
[mc11, mp11, mr11, mv11] = f_mkt(u11)

// Chart-timeframe technicals.
rsi  = ta.rsi(close, rsiLen)
atr  = ta.atr(atrLen)
[macd, macdSig, macdHist] = ta.macd(close, 12, 26, 9)
ma1  = ta.ema(close, maLen1)
ma2  = ta.ema(close, maLen2)
ma3  = ta.ema(close, maLen3)
vwap = ta.vwap(hlc3)

// ───────────────────────────── Score ─────────────────────────────
// 0–100 composite from trend, momentum, relative strength and 52-week position.
// Rule-based: a summary of the numbers on this panel, not a forecast.
bull   = close > ma3 and ma1 > ma2
bear   = close < ma3 and ma1 < ma2
rs1m   = f_ret(dC, c21) - f_ret(bC, b21)
rngPos = na(h52) or na(l52) or h52 == l52 ? na : math.max(0, math.min(1, (close - l52) / (h52 - l52)))
score  = (close > ma3 ? 20 : 0) + (ma1 > ma2 ? 15 : 0) + (close > ma2 ? 10 : 0)
     + (rsi >= 50 and rsi <= 70 ? 15 : rsi > 70 ? 8 : rsi >= 40 ? 5 : 0)
     + (macdHist > 0 ? 10 : 0)
     + (na(rs1m) ? 7.5 : rs1m > 0 ? 15 : 0)
     + (na(rngPos) ? 7.5 : rngPos * 15)
plot(score, "Terminal score", display = display.data_window)

// ───────────────────────────── Overlays ─────────────────────────────
plot(showMA ? ma1 : na, "EMA fast", color = C_AMBER, linewidth = 1)
plot(showMA ? ma2 : na, "EMA mid", color = C_BLUE, linewidth = 1)
plot(showMA ? ma3 : na, "EMA slow", color = C_WHITE, linewidth = 2)
plot(showVWAP ? vwap : na, "VWAP", color = color.new(#C77DFF, 0), linewidth = 1, style = plot.style_linebr)
plot(showPDHL and timeframe.isintraday ? pdH : na, "Prior-day high", color = color.new(C_UP, 40), style = plot.style_linebr)
plot(showPDHL and timeframe.isintraday ? pdL : na, "Prior-day low", color = color.new(C_DN, 40), style = plot.style_linebr)

// ───────────────────────────── Alerts ─────────────────────────────
// Every signal is computed on every bar (outside any condition) so the ta.* history stays correct.
s52h     = ta.crossover(close, h52[1])
s52l     = ta.crossunder(close, l52[1])
sRsiOB   = ta.crossover(rsi, 70)
sRsiOS   = ta.crossunder(rsi, 30)
sEma     = ta.cross(ma1, ma2)
sStrong  = ta.crossover(score, 70)
sWeak    = ta.crossunder(score, 30)
xUp      = ta.crossover(close, lvlAbove)
xDn      = ta.crossunder(close, lvlBelow)
sAbove   = lvlAbove > 0 and xUp
sBelow   = lvlBelow > 0 and xDn
volAvg20 = ta.sma(volume, 20)
sVol     = not na(volAvg20) and volAvg20 > 0 and volume >= volMult * volAvg20
dayStart = ta.change(time("D")) != 0
newDay   = timeframe.isintraday ? dayStart : true
gapOpen  = newDay ? f_ret(open, dPC) : na
sGapUp   = not na(gapOpen) and gapOpen >= gapPct
sGapDn   = not na(gapOpen) and gapOpen <= -gapPct
pdhX     = ta.crossover(close, pdH)
pdlX     = ta.crossunder(close, pdL)
sPdh     = timeframe.isintraday and pdhX
sPdl     = timeframe.isintraday and pdlX

alertcondition(s52h, "New 52-week high", "{{ticker}} broke its 52-week high at {{close}}")
alertcondition(s52l, "New 52-week low", "{{ticker}} broke its 52-week low at {{close}}")
alertcondition(sRsiOB, "RSI overbought", "{{ticker}} RSI crossed above 70")
alertcondition(sRsiOS, "RSI oversold", "{{ticker}} RSI crossed below 30")
alertcondition(sEma, "EMA fast/mid cross", "{{ticker}} fast/mid EMA cross at {{close}}")
alertcondition(sStrong, "Score turned strong", "{{ticker}} terminal score rose above 70")
alertcondition(sWeak, "Score turned weak", "{{ticker}} terminal score fell below 30")
alertcondition(sAbove, "Price above my level", "{{ticker}} crossed above your level, now {{close}}")
alertcondition(sBelow, "Price below my level", "{{ticker}} crossed below your level, now {{close}}")
alertcondition(sVol, "Volume spike", "{{ticker}} volume is unusually high ({{volume}}) at {{close}}")
alertcondition(sGapUp, "Gap up at the open", "{{ticker}} gapped up at the open to {{open}}")
alertcondition(sGapDn, "Gap down at the open", "{{ticker}} gapped down at the open to {{open}}")
alertcondition(sPdh, "Broke prior-day high", "{{ticker}} broke the prior day's high, now {{close}}")
alertcondition(sPdl, "Broke prior-day low", "{{ticker}} broke the prior day's low, now {{close}}")

// One alert for everything: in TradingView pick the condition "Any alert() function call".
// It fires once when a bar closes, listing every signal on that bar.
if barstate.isconfirmed
    sigs = array.new_string()
    if s52h
        array.push(sigs, "new 52-week high")
    if s52l
        array.push(sigs, "new 52-week low")
    if sAbove
        array.push(sigs, "crossed above " + str.tostring(lvlAbove))
    if sBelow
        array.push(sigs, "crossed below " + str.tostring(lvlBelow))
    if sPdh
        array.push(sigs, "broke prior-day high")
    if sPdl
        array.push(sigs, "broke prior-day low")
    if sGapUp
        array.push(sigs, "gap up " + str.tostring(gapOpen, "0.0") + "%")
    if sGapDn
        array.push(sigs, "gap down " + str.tostring(gapOpen, "0.0") + "%")
    if sVol
        array.push(sigs, "volume " + str.tostring(volume / volAvg20, "0.0") + "x average")
    if sRsiOB
        array.push(sigs, "RSI above 70")
    if sRsiOS
        array.push(sigs, "RSI below 30")
    if sEma
        array.push(sigs, ma1 > ma2 ? "fast EMA crossed above mid" : "fast EMA crossed below mid")
    if sStrong
        array.push(sigs, "score above 70")
    if sWeak
        array.push(sigs, "score below 30")
    if array.size(sigs) > 0
        alert(syminfo.ticker + " " + str.tostring(close, format.mintick) + " (" + timeframe.period + "): " + array.join(sigs, ", "), alert.freq_once_per_bar_close)

// ───────────────────────────── Panel ─────────────────────────────
var table T = table.new(f_pos(panelPos), 4, 70, bgcolor = C_BG, frame_color = C_AMBER, frame_width = 1, border_color = C_GRID, border_width = 1)
SZ = f_size(textSz)

f_cell(int c, int r, string t, color tc, color bg, string al) =>
    table.cell(T, c, r, t, text_color = tc, bgcolor = bg, text_size = SZ, text_halign = al, text_font_family = font.family_monospace)

f_band(int r, string t, color tc, color bg) =>
    f_cell(0, r, t, tc, bg, text.align_left)
    table.merge_cells(T, 0, r, 3, r)

// Two label/value pairs on one row.
f_kv(int r, string k1, string v1, color c1, string k2, string v2, color c2) =>
    bg = r % 2 == 0 ? C_BG : C_ALT
    f_cell(0, r, k1, C_AMBER, bg, text.align_left)
    f_cell(1, r, v1, c1, bg, text.align_right)
    f_cell(2, r, k2, C_AMBER, bg, text.align_left)
    f_cell(3, r, v2, c2, bg, text.align_right)

f_big(float x) =>
    na(x) ? "—" : math.abs(x) >= 1e12 ? str.tostring(x / 1e12, "0.00") + "T" : math.abs(x) >= 1e9 ? str.tostring(x / 1e9, "0.00") + "B" : math.abs(x) >= 1e6 ? str.tostring(x / 1e6, "0.00") + "M" : str.tostring(x, "#,##0")

f_val(float x, string fmt, string suffix) => na(x) ? "—" : str.tostring(x, fmt) + suffix

// Macro value with the change since the previous release, e.g. "3.20% (-0.10)".
f_eco_txt(float v, float p) =>
    na(v) ? "—" : str.tostring(v, "0.00") + "%" + (na(p) ? "" : " (" + (v - p >= 0 ? "+" : "") + str.tostring(v - p, "0.00") + ")")

f_watch(int r, string s, float q, float p) =>
    bg = r % 2 == 0 ? C_BG : C_ALT
    chg = na(q) or na(p) ? na : q - p
    pct = f_ret(q, p)
    f_cell(0, r, f_ticker(s), C_AMBER, bg, text.align_left)
    f_cell(1, r, na(q) ? "N/A" : f_num(q), C_WHITE, bg, text.align_right)
    f_cell(2, r, na(chg) ? "—" : (chg >= 0 ? "+" : "") + f_num(chg), f_col(chg), bg, text.align_right)
    f_cell(3, r, f_pct(pct), f_col(pct), bg, text.align_right)

if barstate.islast
    table.clear(T, 0, 0, 3, 69)
    int r = 0

    // Header: security line + description.
    f_band(r, " " + syminfo.ticker + " " + str.upper(syminfo.type) + "  <GO>   " + syminfo.prefix + " · " + syminfo.currency + " · " + timeframe.period, C_BG, C_AMBER)
    r += 1
    f_band(r, " " + str.upper(syminfo.description), C_WHITE, C_BG)
    r += 1

    // Quote.
    last   = close
    chg    = na(dPC) ? na : last - dPC
    chgPct = f_ret(last, dPC)
    f_kv(r, "LAST", f_px(last), C_WHITE, "CHG", na(chg) ? "—" : (chg >= 0 ? "+" : "") + f_px(chg) + " " + f_pct(chgPct), f_col(chg))
    r += 1
    f_kv(r, "OPEN", f_px(dO), C_WHITE, "HIGH", f_px(dH), C_WHITE)
    r += 1
    f_kv(r, "LOW", f_px(dL), C_WHITE, "PREV", f_px(dPC), C_WHITE)
    r += 1
    volRatio = na(dV) or na(dAvgV) or dAvgV == 0 ? na : dV / dAvgV
    f_kv(r, "VOLUME", f_vol(dV), C_WHITE, "AVG20D", f_vol(dAvgV) + (na(volRatio) ? "" : " " + str.tostring(volRatio, "0.0") + "x"), na(volRatio) ? C_WHITE : volRatio >= 1.5 ? C_AMBER : C_WHITE)
    r += 1
    f_kv(r, "52W HI", f_px(h52), C_WHITE, "52W LO", f_px(l52), C_WHITE)
    r += 1
    rngPct = na(h52) or na(l52) or h52 == l52 ? na : (last - l52) / (h52 - l52)
    if not na(rngPct)
        filled = math.max(0, math.min(20, int(math.round(rngPct * 20))))
        f_band(r, " 52W RANGE  L " + str.repeat("█", filled) + str.repeat("░", 20 - filled) + " H  " + str.tostring(rngPct * 100, "0") + "%", C_AMBER, C_BG)
        r += 1

    // Analyst note: plain-English read of the numbers above, with the score.
    if showNote
        scoreTxt = score >= 70 ? "STRONG" : score >= 55 ? "POSITIVE" : score > 45 ? "NEUTRAL" : score > 30 ? "NEGATIVE" : "WEAK"
        scoreCol = score >= 55 ? C_UP : score > 45 ? C_AMBER : C_DN
        f_band(r, " ANALYST NOTE   SCORE " + str.tostring(score, "0") + "/100 " + scoreTxt, C_BG, C_AMBER)
        r += 1
        filledS = int(math.round(score / 5))
        f_band(r, " " + str.repeat("█", filledS) + str.repeat("░", 20 - filledS), scoreCol, C_BG)
        r += 1
        notes = array.new_string()
        if not na(chgPct)
            array.push(notes, "• " + syminfo.ticker + (chgPct >= 0 ? " up " : " down ") + str.tostring(math.abs(chgPct), "0.00") + "% today" + (na(volRatio) ? "." : " on " + str.tostring(volRatio, "0.0") + "x normal volume" + (volRatio >= 1.5 ? " (unusual)." : ".")))
        array.push(notes, bull ? "• Uptrend: above EMA" + str.tostring(maLen3) + ", fast EMA over mid." : bear ? "• Downtrend: below EMA" + str.tostring(maLen3) + ", fast EMA under mid." : "• Mixed trend: the EMAs disagree.")
        array.push(notes, "• RSI " + str.tostring(rsi, "0") + (rsi >= 70 ? " overbought" : rsi <= 30 ? " oversold" : rsi >= 50 ? " firm" : " soft") + "; MACD " + (macdHist > 0 ? "above" : "below") + " its signal.")
        if not na(rngPos)
            array.push(notes, "• At " + str.tostring(rngPos * 100, "0") + "% of the 52w range, " + str.tostring((h52 - last) / h52 * 100, "0.0") + "% below the high.")
        if not na(rs1m)
            array.push(notes, "• 1M vs " + f_ticker(benchSym) + ": " + f_pct(rs1m) + (rs1m >= 0 ? " (leading)." : " (lagging)."))
        nextE = earnings.future_time
        if isStock and not na(nextE)
            daysE = math.ceil((nextE - timenow) / 86400000.0)
            if daysE >= 0 and daysE <= 14
                array.push(notes, "• Earnings in " + str.tostring(daysE) + "d: expect bigger moves.")
        array.push(notes, "Rule-based summary, not advice.")
        f_cell(0, r, array.join(notes, "\n"), C_WHITE, C_BG, text.align_left)
        table.merge_cells(T, 0, r, 3, r)
        r += 1

    // Performance.
    if showPerf
        f_band(r, " PERFORMANCE", C_BG, C_AMBER)
        r += 1
        p1w = f_ret(dC, c5)
        p1m = f_ret(dC, c21)
        p3m = f_ret(dC, c63)
        p1y = f_ret(dC, c252)
        pyt = f_ret(dC, yC)
        f_kv(r, "1D", f_pct(chgPct), f_col(chgPct), "1W", f_pct(p1w), f_col(p1w))
        r += 1
        f_kv(r, "1M", f_pct(p1m), f_col(p1m), "3M", f_pct(p3m), f_col(p3m))
        r += 1
        f_kv(r, "YTD", f_pct(pyt), f_col(pyt), "1Y", f_pct(p1y), f_col(p1y))
        r += 1
        rs1 = rs1m
        rs3 = na(p3m) ? na : p3m - f_ret(bC, b63)
        bt  = f_ticker(benchSym)
        f_kv(r, "vs " + bt + " 1M", f_pct(rs1), f_col(rs1), "vs " + bt + " 3M", f_pct(rs3), f_col(rs3))
        r += 1

    // Technicals.
    if showTech
        f_band(r, " TECHNICALS (" + timeframe.period + ")", C_BG, C_AMBER)
        r += 1
        rsiCol = rsi >= 70 ? C_DN : rsi <= 30 ? C_UP : C_WHITE
        atrPct = f_ret(last + atr, last)
        f_kv(r, "RSI" + str.tostring(rsiLen), str.tostring(rsi, "0.0"), rsiCol, "ATR" + str.tostring(atrLen), f_px(atr) + " (" + str.tostring(atrPct, "0.0") + "%)", C_WHITE)
        r += 1
        f_kv(r, "MACD", str.tostring(macd, "0.00"), f_col(macd), "HIST", str.tostring(macdHist, "0.00"), f_col(macdHist))
        r += 1
        f_kv(r, "EMA" + str.tostring(maLen1), f_px(ma1), last >= ma1 ? C_UP : C_DN, "EMA" + str.tostring(maLen2), f_px(ma2), last >= ma2 ? C_UP : C_DN)
        r += 1
        f_kv(r, "EMA" + str.tostring(maLen3), f_px(ma3), last >= ma3 ? C_UP : C_DN, "VWAP", f_px(vwap), na(vwap) ? C_GREY : last >= vwap ? C_UP : C_DN)
        r += 1
        trend = bull ? "▲ BULLISH" : bear ? "▼ BEARISH" : "◆ NEUTRAL"
        f_band(r, " TREND  " + trend, bull ? C_UP : bear ? C_DN : C_AMBER, C_BG)
        r += 1

    // Fundamentals.
    if showFund and isStock
        f_band(r, " FUNDAMENTALS", C_BG, C_AMBER)
        r += 1
        pe   = na(epsTTM) or epsTTM <= 0 ? na : last / epsTTM
        mcap = na(shares) ? na : shares * last
        f_kv(r, "MKT CAP", f_big(mcap), C_WHITE, "P/E", f_val(pe, "0.0", "x"), C_WHITE)
        r += 1
        f_kv(r, "EPS TTM", f_val(epsTTM, "0.00", ""), f_col(epsTTM), "REV TTM", f_big(revTTM), C_WHITE)
        r += 1
        f_kv(r, "REV YoY", f_pct(revYoY), f_col(revYoY), "FCF TTM", f_big(fcfTTM), f_col(fcfTTM))
        r += 1
        f_kv(r, "GROSS M", f_val(grossM, "0.0", "%"), C_WHITE, "NET M", f_val(netM, "0.0", "%"), f_col(netM))
        r += 1
        f_kv(r, "ROE", f_val(roe, "0.0", "%"), f_col(roe), "DEBT/EQ", f_val(debtEq, "0.00", "x"), na(debtEq) ? C_GREY : debtEq > 2 ? C_DN : C_WHITE)
        r += 1
        surprise = na(epsAct) or na(epsEst) or epsEst == 0 ? na : (epsAct - epsEst) / math.abs(epsEst) * 100
        f_kv(r, "DIV YLD", f_val(divYld, "0.00", "%"), C_WHITE, "EPS SURP", f_pct(surprise), f_col(surprise))
        r += 1
        nextEarn = earnings.future_time
        f_band(r, " NEXT EARNINGS  " + (na(nextEarn) ? "—" : str.format_time(int(nextEarn), "yyyy-MM-dd", syminfo.timezone) + "  (" + str.tostring(math.ceil((nextEarn - timenow) / 86400000.0)) + "d)"), C_AMBER, C_BG)
        r += 1

    // Macro.
    if showMacro
        f_band(r, " MACRO — " + macroCC, C_BG, C_AMBER)
        r += 1
        f_kv(r, "POLICY RT", f_eco_txt(ecoRate, ecoRateP), C_WHITE, "CPI YoY", f_eco_txt(ecoInfl, ecoInflP), na(ecoInfl) or na(ecoInflP) ? C_WHITE : ecoInfl > ecoInflP ? C_DN : C_UP)
        r += 1
        f_kv(r, "UNEMPL", f_eco_txt(ecoUnem, ecoUnemP), na(ecoUnem) or na(ecoUnemP) ? C_WHITE : ecoUnem > ecoUnemP ? C_DN : C_UP, "GDP QoQ", f_eco_txt(ecoGdp, ecoGdpP), f_col(ecoGdp))
        r += 1

    // Multi-asset monitor.
    if showWatch
        f_band(r, " MONITOR", C_BG, C_AMBER)
        r += 1
        f_cell(0, r, "TICKER", C_GREY, C_BG, text.align_left)
        f_cell(1, r, "LAST", C_GREY, C_BG, text.align_right)
        f_cell(2, r, "NET", C_GREY, C_BG, text.align_right)
        f_cell(3, r, "%CHG", C_GREY, C_BG, text.align_right)
        r += 1
        f_watch(r, w1, q1, p1)
        r += 1
        f_watch(r, w2, q2, p2)
        r += 1
        f_watch(r, w3, q3, p3)
        r += 1
        f_watch(r, w4, q4, p4)
        r += 1
        f_watch(r, w5, q5, p5)
        r += 1
        f_watch(r, w6, q6, p6)
        r += 1

    // Status line.
    f_band(r, " " + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + " " + syminfo.timezone + (barstate.isrealtime ? "  ● LIVE" : "  ○ DELAYED/CLOSED"), C_GREY, C_BG)


// ───────────────────────────── Market panel ─────────────────────────────
var table M = table.new(f_pos(mktPos), 4, 32, bgcolor = C_BG, frame_color = C_AMBER, frame_width = 1, border_color = C_GRID, border_width = 1)

f_mcell(int c, int r, string t, color tc, color bg, string al) =>
    table.cell(M, c, r, t, text_color = tc, bgcolor = bg, text_size = SZ, text_halign = al, text_font_family = font.family_monospace)

f_mband(int r, string t, color tc, color bg) =>
    f_mcell(0, r, t, tc, bg, text.align_left)
    table.merge_cells(M, 0, r, 3, r)

// Black at 0%, full green/red at ±heatScale.
f_heat(float x) =>
    na(x) ? #1A1A1A : x >= 0 ? color.from_gradient(x, 0, heatScale, #1A1A1A, #00A651) : color.from_gradient(x, -heatScale, 0, #D32F2F, #1A1A1A)

if barstate.islast and showMkt
    table.clear(M, 0, 0, 3, 31)
    syms = array.from(u0, u1, u2, u3, u4, u5, u6, u7, u8, u9, u10, u11)
    lst  = array.from(mc0, mc1, mc2, mc3, mc4, mc5, mc6, mc7, mc8, mc9, mc10, mc11)
    prv  = array.from(mp0, mp1, mp2, mp3, mp4, mp5, mp6, mp7, mp8, mp9, mp10, mp11)
    rsis = array.from(mr0, mr1, mr2, mr3, mr4, mr5, mr6, mr7, mr8, mr9, mr10, mr11)
    rvol = array.from(mv0, mv1, mv2, mv3, mv4, mv5, mv6, mv7, mv8, mv9, mv10, mv11)
    chgs = array.new_float()
    for i = 0 to 11
        array.push(chgs, array.get(syms, i) == "" ? na : f_ret(array.get(lst, i), array.get(prv, i)))

    // Breadth, leader and laggard.
    int nUp = 0
    int nOk = 0
    int iBest = -1
    int iWorst = -1
    for i = 0 to 11
        x = array.get(chgs, i)
        if not na(x)
            nOk += 1
            nUp += x >= 0 ? 1 : 0
            if iBest < 0 or x > array.get(chgs, iBest)
                iBest := i
            if iWorst < 0 or x < array.get(chgs, iWorst)
                iWorst := i

    int r = 0
    f_mband(r, " MARKET — " + str.upper(universe) + "   HEAT", C_BG, C_AMBER)
    r += 1
    // 4 × 3 heatmap.
    for row = 0 to 2
        for col = 0 to 3
            i = row * 4 + col
            x = array.get(chgs, i)
            sym = array.get(syms, i)
            f_mcell(col, r, sym == "" ? "" : f_ticker(sym) + "\n" + f_pct(x), na(x) ? C_GREY : C_WHITE, f_heat(x), text.align_center)
        r += 1
    breadthTxt = nOk == 0 ? " No data for this universe." : " BREADTH " + str.tostring(nUp) + "/" + str.tostring(nOk) + " up"
         + (iBest >= 0 ? "  ▲ " + f_ticker(array.get(syms, iBest)) + " " + f_pct(array.get(chgs, iBest)) : "")
         + (iWorst >= 0 ? "  ▼ " + f_ticker(array.get(syms, iWorst)) + " " + f_pct(array.get(chgs, iWorst)) : "")
    f_mband(r, breadthTxt, nOk > 0 and nUp * 2 >= nOk ? C_UP : C_DN, C_BG)
    r += 1

    // Screener: filter, then sort descending by the chosen column.
    if showScr
        f_mband(r, " SCREENER — " + scrFilter + " · by " + scrSort, C_BG, C_AMBER)
        r += 1
        f_mcell(0, r, "TICKER", C_GREY, C_BG, text.align_left)
        f_mcell(1, r, "%CHG", C_GREY, C_BG, text.align_right)
        f_mcell(2, r, "RSI", C_GREY, C_BG, text.align_right)
        f_mcell(3, r, "RVOL", C_GREY, C_BG, text.align_right)
        r += 1
        keys = array.new_float()
        kept = array.new_bool()
        for i = 0 to 11
            x  = array.get(chgs, i)
            ri = array.get(rsis, i)
            rv = array.get(rvol, i)
            keep = not na(x) and (scrFilter == "All" or (scrFilter == "Gainers" and x > 0) or (scrFilter == "Losers" and x < 0)
                 or (scrFilter == "Oversold (RSI < 30)" and ri < 30) or (scrFilter == "Overbought (RSI > 70)" and ri > 70)
                 or (scrFilter == "Unusual volume (RVOL > 1.5)" and rv > 1.5))
            k = scrSort == "RSI" ? ri : scrSort == "Relative volume" ? rv : x
            // Losers read best worst-first; everything else best-first.
            k := scrFilter == "Losers" and scrSort == "% Change" ? -k : k
            array.push(keys, keep ? (na(k) ? -1e9 : k) : -1e12)
            array.push(kept, keep)
        order = array.sort_indices(keys, order.descending)
        int shown = 0
        for j = 0 to 11
            i = array.get(order, j)
            if array.get(kept, i) and shown < scrRows
                bg = shown % 2 == 0 ? C_BG : C_ALT
                x  = array.get(chgs, i)
                ri = array.get(rsis, i)
                rv = array.get(rvol, i)
                f_mcell(0, r, f_ticker(array.get(syms, i)), C_AMBER, bg, text.align_left)
                f_mcell(1, r, f_pct(x), f_col(x), bg, text.align_right)
                f_mcell(2, r, na(ri) ? "—" : str.tostring(ri, "0"), na(ri) ? C_GREY : ri >= 70 ? C_DN : ri <= 30 ? C_UP : C_WHITE, bg, text.align_right)
                f_mcell(3, r, na(rv) ? "—" : str.tostring(rv, "0.0") + "x", na(rv) ? C_GREY : rv >= 1.5 ? C_AMBER : C_WHITE, bg, text.align_right)
                r += 1
                shown += 1
        if shown == 0
            f_mband(r, " No symbols match this filter.", C_GREY, C_BG)
