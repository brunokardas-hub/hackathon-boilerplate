# --- You ---
OWNER_NAME=Bruno
OWNER_PHONE=+48123456789          # your mobile, E.164 format
TIMEZONE=Europe/Warsaw

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...         # the number Jarvis calls from
PUBLIC_URL=https://your-tunnel.ngrok.app   # where Twilio can reach this server
JARVIS_VOICE=Polly.Brian          # British butler voice
SPEECH_LANGUAGE=en-GB

# --- Google (Calendar + Gmail, read-only) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Your plan / to-do list (any markdown) ---
PLAN_FILE=plan.md

# --- Schedule ---
BRIEFING_TIME=08:00
EMAIL_CHECK_MINUTES=10
MEETING_REMINDER_MINUTES=10
QUIET_HOURS_START=22:30
QUIET_HOURS_END=07:30
URGENT_ALERT_MODE=call            # call | sms
PORT=5000
